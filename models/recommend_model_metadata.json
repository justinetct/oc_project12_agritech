{
  "service": "recommend",
  "model_type": "ExtraTreesRegressor",
  "artifact": "recommend_model.joblib",
  "target": "yield_t_ha",
  "features": [
    "crop",
    "year",
    "temp_hist",
    "rain_mm",
    "log_pest_hist",
    "lat_abs",
    "geo_x",
    "geo_y",
    "geo_z"
  ],
  "categorical_features": [
    "crop"
  ],
  "numeric_features": [
    "year",
    "temp_hist",
    "rain_mm",
    "log_pest_hist",
    "lat_abs",
    "geo_x",
    "geo_y",
    "geo_z"
  ],
  "categorical_values": {
    "crop": [
      "Cassava",
      "Maize",
      "Plantains and others",
      "Potatoes",
      "Rice, paddy",
      "Sorghum",
      "Soybeans",
      "Sweet potatoes",
      "Wheat",
      "Yams"
    ]
  },
  "preprocessing": "OneHotEncoder(handle_unknown='ignore') on categorical, passthrough on numeric",
  "model_params": {
    "n_estimators": 150,

# Configuration locale facultative : copier en .env (jamais versionné) et renseigner les valeurs.
# Sans .env, le projet s'exécute avec un suivi MLflow local (mlruns/) et sans notification.

MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

NOTIFICATIONS_ENABLED=false
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# --- Observabilité API (tâche 19) ---
# Base SQLite de monitoring des appels /predict et /recommend.
# Défaut local : sqlite:///data/monitoring/api.sqlite (chemin relatif au projet).
# Prod (Docker) : sqlite:////app/data/monitoring/api.sqlite (chemin absolu, 4 slashes).
DATABASE_URL=

# Nom court de l'environnement, persisté dans api_requests.environment.
# Défaut : local. Prod : prod.
ENVIRONMENT=

# Logfire (optionnel). Sans token : aucun envoi réseau, mode local silencieux.
# LOGFIRE_ENVIRONMENT reprend ENVIRONMENT s'il n'est pas renseigné.
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=
LOGFIRE_SERVICE_NAME=

# Secret des endpoints /monitoring/* (en-tête Authorization: Bearer <token>).
# Sans valeur : ces endpoints restent indisponibles. Ne jamais versionner le vrai token.
MONITORING_API_TOKEN=
